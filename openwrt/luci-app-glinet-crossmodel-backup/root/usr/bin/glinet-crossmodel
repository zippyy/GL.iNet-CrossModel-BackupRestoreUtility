#!/bin/sh
# CLI for local/direct mode and the streamed agentless remote runtime.

set -eu

if [ "${GCM_CORE_LOADED:-0}" != 1 ]; then
	GCM_LIB=${GCM_LIB:-/usr/lib/glinet-crossmodel/core.sh}
	[ -r "$GCM_LIB" ] || { echo "ERROR: runtime library is missing: $GCM_LIB" >&2; exit 1; }
	# shellcheck source=/dev/null
	. "$GCM_LIB"
fi

usage() {
	cat >&2 <<'EOF'
Usage:
  glinet-crossmodel facts
  glinet-crossmodel create --output ARCHIVE [--strategy portable|clone|remote-safe|snapshot]
      [--id UUID] [--name NAME] [--notes NOTES] [--categories CSV]
      [--scripts-list FILE] [--binaries-list FILE]
  glinet-crossmodel inspect ARCHIVE [--human]
  glinet-crossmodel validate ARCHIVE [--categories CSV] [--dangerous-device-override]
  glinet-crossmodel restore ARCHIVE [--categories CSV] [--packages CSV]
      [--direct-custom-files] [--dangerous-device-override] [--allow-legacy]
  glinet-crossmodel packages ARCHIVE
  glinet-crossmodel version

Strategies:
  portable     Cross-model semantic profile (default)
  clone        Same-model clone with device identity sanitized
  remote-safe  Same-model clone preserving remote management state
  snapshot     Exact-device disaster-recovery snapshot
EOF
	exit 2
}

all_categories='wifi,lan,dhcp,dns,firewall,timezone,ddns,vpn,packages,persistent,custom-files,custom-binaries'

command=${1:-}
[ -n "$command" ] || usage
shift || true
GCM_CALLER_OP_ID=${GCM_OP_ID:-}
GCM_COMPONENT=cli
gcm_prepare_operation "$command"
gcm_diag INFO "action=$command" 'stage=dispatch' 'msg=CLI operation accepted'

case "$command" in
	facts)
		[ "$#" -eq 0 ] || usage
		GCM_COMPONENT=facts
		export GCM_COMPONENT
		facts_started=$(date +%s 2>/dev/null || printf 0)
		gcm_diag INFO 'action=facts' 'stage=start' 'msg=Router fact collection started'
		gcm_facts_json
		gcm_diag INFO 'action=facts' 'stage=complete' "elapsed_seconds=$(gcm_elapsed "$facts_started")" 'result=success' 'msg=Router facts emitted as JSON'
		;;
	version)
		[ "$#" -eq 0 ] || usage
		printf '%s\n' "$GCM_TOOL_VERSION"
		;;
	create)
		# Backward-compatible positional v1 caller shape. It creates a v2
		# Portable Profile; no v1 archive is ever emitted.
		if [ "$#" -eq 5 ] && [ "${1#--}" = "$1" ]; then
			output=$1; profile_id=$2; categories=$3; scripts=$4; binaries=$5
			GCM_OP_ID=$profile_id; export GCM_OP_ID
			gcm_create "$output" portable "$profile_id" 'Portable Profile' '' "$categories" "$scripts" "$binaries"
			exit
		fi
		output=''; strategy=portable; profile_id=$GCM_OP_ID; name=''; notes=''; categories=$all_categories; scripts=/dev/null; binaries=/dev/null
		while [ "$#" -gt 0 ]; do
			case "$1" in
				--output) [ "$#" -ge 2 ] || usage; output=$2; shift 2 ;;
				--strategy) [ "$#" -ge 2 ] || usage; strategy=$2; shift 2 ;;
				--id) [ "$#" -ge 2 ] || usage; profile_id=$2; [ -n "$GCM_CALLER_OP_ID" ] || GCM_OP_ID=$2; export GCM_OP_ID; shift 2 ;;
				--name) [ "$#" -ge 2 ] || usage; name=$2; shift 2 ;;
				--notes) [ "$#" -ge 2 ] || usage; notes=$2; shift 2 ;;
				--categories) [ "$#" -ge 2 ] || usage; categories=$2; shift 2 ;;
				--scripts-list) [ "$#" -ge 2 ] || usage; scripts=$2; shift 2 ;;
				--binaries-list) [ "$#" -ge 2 ] || usage; binaries=$2; shift 2 ;;
				*) usage ;;
			esac
		done
		[ -n "$output" ] || { echo 'ERROR: --output is required.' >&2; exit 2; }
		[ -n "$name" ] || name=$(gcm_strategy_label "$strategy")
		gcm_create "$output" "$strategy" "$profile_id" "$name" "$notes" "$categories" "$scripts" "$binaries"
		;;
	inspect)
		[ "$#" -ge 1 ] || usage
		archive=$1; shift; format=json
		while [ "$#" -gt 0 ]; do case "$1" in --human) format=human; shift ;; *) usage ;; esac; done
		gcm_inspect "$archive" "$format"
		;;
	validate)
		[ "$#" -ge 1 ] || usage
		archive=$1; shift; categories=$all_categories; override=0
		while [ "$#" -gt 0 ]; do
			case "$1" in
				--categories) [ "$#" -ge 2 ] || usage; categories=$2; shift 2 ;;
				--dangerous-device-override) override=1; shift ;;
				# Legacy controller positional category argument.
				*) if [ "$#" -eq 1 ] && [ "${1#--}" = "$1" ]; then categories=$1; shift; else usage; fi ;;
			esac
		done
		gcm_validate "$archive" "$categories" "$override"
		;;
	restore)
		[ "$#" -ge 1 ] || usage
		archive=$1; shift; categories=$all_categories; packages=''; direct=0; override=0; allow_legacy=0
		# Legacy controller shape: ARCHIVE CATEGORIES INSTALL_ALL DIRECT. The
		# install-all flag is intentionally ignored; v2 requires explicit names.
		if [ "$#" -eq 3 ] && [ "${1#--}" = "$1" ]; then
			categories=$1; direct=$3; shift 3
		fi
		while [ "$#" -gt 0 ]; do
			case "$1" in
				--categories) [ "$#" -ge 2 ] || usage; categories=$2; shift 2 ;;
				--packages) [ "$#" -ge 2 ] || usage; packages=$2; shift 2 ;;
				--direct-custom-files) direct=1; shift ;;
				--dangerous-device-override) override=1; shift ;;
				--allow-legacy) allow_legacy=1; shift ;;
				*) usage ;;
			esac
		done
		gcm_restore "$archive" "$categories" "$packages" "$direct" "$override" "$allow_legacy"
		;;
	packages)
		[ "$#" -eq 1 ] || usage
		gcm_packages_review "$1"
		;;
	*) usage ;;
esac
