#!/bin/sh
# Agentless SSH coordinator. The same IPK is installed only on the controller;
# core.sh and the CLI are concatenated and streamed to each remote endpoint.

set -eu
PATH=${GCM_PATH:-/usr/sbin:/usr/bin:/sbin:/bin}
CORE=${GCM_CORE:-/usr/lib/glinet-crossmodel/core.sh}
CLI=${GCM_CLI:-/usr/bin/glinet-crossmodel}
KNOWN_HOSTS=${GCM_KNOWN_HOSTS:-/root/.ssh/known_hosts}
CLEANUP_ACTIVE=0
CLEANUP_HOST=''
CLEANUP_PORT=''
CLEANUP_USER=''
CLEANUP_AUTH=''
CLEANUP_CREDENTIAL=''
CLEANUP_PATHS=''

log() { printf '%s\n' "$*"; }
die() { log "ERROR: $*" >&2; exit 1; }
shell_quote() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\"'\\\"'/g")"; }

usage() {
	cat >&2 <<'EOF'
Usage:
  glinet-crossmodel-remote facts HOST PORT USER AUTH CREDENTIAL
  glinet-crossmodel-remote create OUTPUT STRATEGY UUID NAME NOTES CATEGORIES SCRIPTS BINARIES HOST PORT USER AUTH CREDENTIAL
  glinet-crossmodel-remote validate ARCHIVE UUID CATEGORIES OVERRIDE HOST PORT USER AUTH CREDENTIAL
  glinet-crossmodel-remote restore ARCHIVE UUID CATEGORIES PACKAGES DIRECT OVERRIDE ALLOW_LEGACY HOST PORT USER AUTH CREDENTIAL
  glinet-crossmodel-remote packages ARCHIVE UUID HOST PORT USER AUTH CREDENTIAL

AUTH is password, key, or agent. CREDENTIAL is a mode-0600 password file, a
private-key path, or '-' for agent authentication. Passwords are never accepted
as command-line values.
EOF
	exit 2
}

valid_host() { case "$1" in ''|*[!A-Za-z0-9._:-]*) return 1 ;; *) return 0 ;; esac; }
valid_port() { case "$1" in ''|*[!0-9]*) return 1 ;; esac; [ "$1" -ge 1 ] 2>/dev/null && [ "$1" -le 65535 ] 2>/dev/null; }
valid_user() { case "$1" in ''|*[!A-Za-z0-9._-]*) return 1 ;; *) return 0 ;; esac; }
valid_id() { case "$1" in ''|*[!A-Fa-f0-9-]*) return 1 ;; *) return 0 ;; esac; }

remote_target() {
	host=$1; user=$2
	case "$host" in *:) die 'Invalid remote host.' ;; *:*) printf '%s@[%s]\n' "$user" "$host" ;; *) printf '%s@%s\n' "$user" "$host" ;; esac
}

prepare_connection() {
	host=$1; port=$2; user=$3; auth=$4; credential=$5
	valid_host "$host" || die 'Remote host contains invalid characters.'
	valid_port "$port" || die 'Remote SSH port must be 1 through 65535.'
	valid_user "$user" || die 'Remote SSH username contains invalid characters.'
	[ -r "$CORE" ] && [ -r "$CLI" ] || die 'Streamed runtime files are missing.'
	command -v ssh >/dev/null 2>&1 || die 'OpenSSH client is not installed.'
	command -v scp >/dev/null 2>&1 || die 'OpenSSH SCP client is not installed.'
	command -v sha256sum >/dev/null 2>&1 || die 'sha256sum is not available on the controller.'
	case "$auth" in
		password) [ -f "$credential" ] || die 'Temporary SSH password file is missing.'; command -v sshpass >/dev/null 2>&1 || die 'sshpass is not installed.' ;;
		key) [ -f "$credential" ] || die 'SSH private-key file is missing.' ;;
		agent) [ "$credential" = - ] || die 'Agent authentication credential must be -.' ;;
		*) die 'SSH authentication must be password, key, or agent.' ;;
	esac
	known_hosts_dir=${KNOWN_HOSTS%/*}
	[ "$known_hosts_dir" != "$KNOWN_HOSTS" ] || known_hosts_dir='.'
	mkdir -p "$known_hosts_dir"
	chmod 700 "$known_hosts_dir"
	touch "$KNOWN_HOSTS"
	chmod 600 "$KNOWN_HOSTS"
}

ssh_run() {
	host=$1; port=$2; user=$3; auth=$4; credential=$5; shift 5
	target=$(remote_target "$host" "$user")
	case "$auth" in
		password)
			sshpass -f "$credential" ssh -o BatchMode=no -o PasswordAuthentication=yes \
				-o ConnectTimeout=12 -o ServerAliveInterval=5 -o ServerAliveCountMax=2 \
				-o StrictHostKeyChecking=accept-new -o UserKnownHostsFile="$KNOWN_HOSTS" \
				-p "$port" "$target" "$@"
			;;
		key)
			ssh -i "$credential" -o IdentitiesOnly=yes -o BatchMode=yes \
				-o ConnectTimeout=12 -o ServerAliveInterval=5 -o ServerAliveCountMax=2 \
				-o StrictHostKeyChecking=accept-new -o UserKnownHostsFile="$KNOWN_HOSTS" \
				-p "$port" "$target" "$@"
			;;
		agent)
			ssh -o BatchMode=yes -o ConnectTimeout=12 -o ServerAliveInterval=5 -o ServerAliveCountMax=2 \
				-o StrictHostKeyChecking=accept-new -o UserKnownHostsFile="$KNOWN_HOSTS" \
				-p "$port" "$target" "$@"
			;;
	esac
}

scp_to_remote() {
	local_file=$1; host=$2; port=$3; user=$4; auth=$5; credential=$6; remote_path=$7
	[ -f "$local_file" ] || die "Local input is missing: $local_file"
	target=$(remote_target "$host" "$user")
	case "$auth" in
		password) sshpass -f "$credential" scp -O -o BatchMode=no -o PasswordAuthentication=yes -o ConnectTimeout=12 -o StrictHostKeyChecking=accept-new -o UserKnownHostsFile="$KNOWN_HOSTS" -P "$port" "$local_file" "${target}:${remote_path}" ;;
		key) scp -O -i "$credential" -o IdentitiesOnly=yes -o BatchMode=yes -o ConnectTimeout=12 -o StrictHostKeyChecking=accept-new -o UserKnownHostsFile="$KNOWN_HOSTS" -P "$port" "$local_file" "${target}:${remote_path}" ;;
		agent) scp -O -o BatchMode=yes -o ConnectTimeout=12 -o StrictHostKeyChecking=accept-new -o UserKnownHostsFile="$KNOWN_HOSTS" -P "$port" "$local_file" "${target}:${remote_path}" ;;
	esac
}

scp_from_remote() {
	host=$1; port=$2; user=$3; auth=$4; credential=$5; remote_path=$6; local_file=$7
	target=$(remote_target "$host" "$user")
	case "$auth" in
		password) sshpass -f "$credential" scp -O -o BatchMode=no -o PasswordAuthentication=yes -o ConnectTimeout=12 -o StrictHostKeyChecking=accept-new -o UserKnownHostsFile="$KNOWN_HOSTS" -P "$port" "${target}:${remote_path}" "$local_file" ;;
		key) scp -O -i "$credential" -o IdentitiesOnly=yes -o BatchMode=yes -o ConnectTimeout=12 -o StrictHostKeyChecking=accept-new -o UserKnownHostsFile="$KNOWN_HOSTS" -P "$port" "${target}:${remote_path}" "$local_file" ;;
		agent) scp -O -o BatchMode=yes -o ConnectTimeout=12 -o StrictHostKeyChecking=accept-new -o UserKnownHostsFile="$KNOWN_HOSTS" -P "$port" "${target}:${remote_path}" "$local_file" ;;
	esac || { rm -f "$local_file"; die 'Could not download the remote archive.'; }
	[ -s "$local_file" ] || die 'Remote router returned an empty archive.'
}

stream_cli() {
	host=$1; port=$2; user=$3; auth=$4; credential=$5; shift 5
	if [ "${GCM_DEFER_RELOAD:-0}" = 1 ]; then remote_command='env GCM_DEFER_RELOAD=1 sh -s --'; else remote_command='sh -s --'; fi
	for argument in "$@"; do remote_command="$remote_command $(shell_quote "$argument")"; done
	{ cat "$CORE"; printf '\n'; cat "$CLI"; } | ssh_run "$host" "$port" "$user" "$auth" "$credential" "$remote_command"
}

local_sha256() { sha256sum "$1" | awk '{print $1}'; }

verify_remote_copy() {
	local_file=$1; host=$2; port=$3; user=$4; auth=$5; credential=$6; remote_path=$7
	local_sum=$(local_sha256 "$local_file")
	remote_output=$(ssh_run "$host" "$port" "$user" "$auth" "$credential" "sha256sum $(shell_quote "$remote_path") 2>/dev/null") || die 'Could not calculate SHA-256 on the remote router.'
	remote_sum=${remote_output%% *}
	[ "$local_sum" = "$remote_sum" ] || die "Remote transfer SHA-256 mismatch (local $local_sum, remote ${remote_sum:-missing})."
	ssh_run "$host" "$port" "$user" "$auth" "$credential" "tar -tzf $(shell_quote "$remote_path") >/dev/null 2>&1" || die 'Remote router cannot read the transferred archive.'
}

cleanup_remote() {
	host=$1; port=$2; user=$3; auth=$4; credential=$5; shift 5
	command='rm -f'
	for path in "$@"; do command="$command $(shell_quote "$path")"; done
	ssh_run "$host" "$port" "$user" "$auth" "$credential" "$command" >/dev/null 2>&1 || true
}

track_cleanup() {
	CLEANUP_HOST=$1; CLEANUP_PORT=$2; CLEANUP_USER=$3; CLEANUP_AUTH=$4; CLEANUP_CREDENTIAL=$5; shift 5
	CLEANUP_PATHS=$*
	CLEANUP_ACTIVE=1
}

clear_cleanup() { CLEANUP_ACTIVE=0; CLEANUP_PATHS=''; }

cleanup_tracked() {
	status=$?
	if [ "$CLEANUP_ACTIVE" = 1 ]; then
		CLEANUP_ACTIVE=0
		# Tracked remote paths are generated safe /tmp names without spaces.
		cleanup_remote "$CLEANUP_HOST" "$CLEANUP_PORT" "$CLEANUP_USER" "$CLEANUP_AUTH" "$CLEANUP_CREDENTIAL" $CLEANUP_PATHS
	fi
	trap - EXIT HUP INT TERM
	[ "$status" -eq 0 ] || exit "$status"
}

trap cleanup_tracked EXIT HUP INT TERM

remote_facts() {
	[ "$#" -eq 5 ] || usage
	prepare_connection "$@"
	stream_cli "$@" facts
}

remote_create() {
	[ "$#" -eq 13 ] || usage
	output=$1; strategy=$2; id=$3; name=$4; notes=$5; categories=$6; scripts=$7; binaries=$8; host=$9
	shift 9; port=$1; user=$2; auth=$3; credential=$4
	valid_id "$id" || die 'Invalid profile UUID.'
	prepare_connection "$host" "$port" "$user" "$auth" "$credential"
	remote_base="/tmp/gcm-$id"
	remote_archive="$remote_base.tar.gz"; remote_scripts="$remote_base-scripts"; remote_binaries="$remote_base-binaries"
	track_cleanup "$host" "$port" "$user" "$auth" "$credential" "$remote_archive" "$remote_scripts" "$remote_binaries"
	scp_to_remote "$scripts" "$host" "$port" "$user" "$auth" "$credential" "$remote_scripts"
	scp_to_remote "$binaries" "$host" "$port" "$user" "$auth" "$credential" "$remote_binaries"
	if ! stream_cli "$host" "$port" "$user" "$auth" "$credential" create --output "$remote_archive" --strategy "$strategy" --id "$id" --name "$name" --notes "$notes" --categories "$categories" --scripts-list "$remote_scripts" --binaries-list "$remote_binaries"; then
		cleanup_remote "$host" "$port" "$user" "$auth" "$credential" "$remote_archive" "$remote_scripts" "$remote_binaries"; exit 1
	fi
	scp_from_remote "$host" "$port" "$user" "$auth" "$credential" "$remote_archive" "$output"
	verify_remote_copy "$output" "$host" "$port" "$user" "$auth" "$credential" "$remote_archive"
	cleanup_remote "$host" "$port" "$user" "$auth" "$credential" "$remote_archive" "$remote_scripts" "$remote_binaries"
	clear_cleanup
	log "CREATED=$output"
	log "REMOTE_SOURCE=$host"
}

remote_validate() {
	[ "$#" -eq 9 ] || usage
	archive=$1; id=$2; categories=$3; override=$4; host=$5; port=$6; user=$7; auth=$8; credential=$9
	valid_id "$id" || die 'Invalid operation UUID.'
	prepare_connection "$host" "$port" "$user" "$auth" "$credential"
	remote_archive="/tmp/gcm-validate-$id.tar.gz"
	track_cleanup "$host" "$port" "$user" "$auth" "$credential" "$remote_archive"
	scp_to_remote "$archive" "$host" "$port" "$user" "$auth" "$credential" "$remote_archive"
	verify_remote_copy "$archive" "$host" "$port" "$user" "$auth" "$credential" "$remote_archive"
	if [ "$override" = 1 ]; then
		if stream_cli "$host" "$port" "$user" "$auth" "$credential" validate "$remote_archive" --categories "$categories" --dangerous-device-override; then status=0; else status=$?; fi
	else
		if stream_cli "$host" "$port" "$user" "$auth" "$credential" validate "$remote_archive" --categories "$categories"; then status=0; else status=$?; fi
	fi
	cleanup_remote "$host" "$port" "$user" "$auth" "$credential" "$remote_archive"
	clear_cleanup
	return "$status"
}

remote_restore() {
	[ "$#" -eq 12 ] || usage
	archive=$1; id=$2; categories=$3; packages=$4; direct=$5; override=$6; allow_legacy=$7; host=$8; port=$9
	shift 9; user=$1; auth=$2; credential=$3
	valid_id "$id" || die 'Invalid operation UUID.'
	prepare_connection "$host" "$port" "$user" "$auth" "$credential"
	remote_archive="/tmp/gcm-restore-$id.tar.gz"
	track_cleanup "$host" "$port" "$user" "$auth" "$credential" "$remote_archive"
	scp_to_remote "$archive" "$host" "$port" "$user" "$auth" "$credential" "$remote_archive"
	verify_remote_copy "$archive" "$host" "$port" "$user" "$auth" "$credential" "$remote_archive"
	set -- restore "$remote_archive" --categories "$categories"
	[ -n "$packages" ] && set -- "$@" --packages "$packages"
	[ "$direct" = 1 ] && set -- "$@" --direct-custom-files
	[ "$override" = 1 ] && set -- "$@" --dangerous-device-override
	[ "$allow_legacy" = 1 ] && set -- "$@" --allow-legacy
	if ! GCM_DEFER_RELOAD=1 stream_cli "$host" "$port" "$user" "$auth" "$credential" "$@"; then
		cleanup_remote "$host" "$port" "$user" "$auth" "$credential" "$remote_archive"; exit 1
	fi
	cleanup_remote "$host" "$port" "$user" "$auth" "$credential" "$remote_archive"
	clear_cleanup
	log "REMOTE_TARGET=$host"
}

remote_packages() {
	[ "$#" -eq 7 ] || usage
	archive=$1; id=$2; host=$3; port=$4; user=$5; auth=$6; credential=$7
	prepare_connection "$host" "$port" "$user" "$auth" "$credential"
	remote_archive="/tmp/gcm-packages-$id.tar.gz"
	track_cleanup "$host" "$port" "$user" "$auth" "$credential" "$remote_archive"
	scp_to_remote "$archive" "$host" "$port" "$user" "$auth" "$credential" "$remote_archive"
	verify_remote_copy "$archive" "$host" "$port" "$user" "$auth" "$credential" "$remote_archive"
	if stream_cli "$host" "$port" "$user" "$auth" "$credential" packages "$remote_archive"; then status=0; else status=$?; fi
	cleanup_remote "$host" "$port" "$user" "$auth" "$credential" "$remote_archive"
	clear_cleanup
	return "$status"
}

case "${1:-}" in
	facts) shift; remote_facts "$@" ;;
	create) shift; remote_create "$@" ;;
	validate) shift; remote_validate "$@" ;;
	restore) shift; remote_restore "$@" ;;
	packages) shift; remote_packages "$@" ;;
	*) usage ;;
esac
